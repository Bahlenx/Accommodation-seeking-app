<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.IkhayaAccommodationSeekingApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Keep your existing colors here -->

        <!-- Brand Colors -->
        <item name="colorPrimary">@color/colorSecondary</item>
        <item name="colorPrimaryVariant">@color/colorSecondary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorPrimary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/appBackground</item>

        <!-- Push all activity content cleanly below the status bar -->
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:statusBarColor">@color/appBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Fix native EditText.setError() popup window text visibility -->
        <item name="android:textColorPrimaryInverse">#FFFFFF</item>
        <item name="android:textColorSecondaryInverse">#FFFFFF</item>
        <item name="android:colorForegroundInverse">#FFFFFF</item>
        <item name="android:colorBackgroundCacheHint">@null</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>