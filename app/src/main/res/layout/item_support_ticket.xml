<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Category & Date -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTicketCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Technical Bug / Crash"
                android:textColor="#BA5536"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTicketStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/custom_input"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="OPEN"
                android:textColor="#2DCE89"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Reporter Metadata -->
        <TextView
            android:id="@+id/tvTicketReporter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="By: User (TENANT)"
            android:textColor="#8C7A70"
            android:textSize="12sp" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvTicketDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:text="Problem description..."
            android:textColor="#1F1614"
            android:textSize="14sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#F0EBE6" />

        <!-- Admin Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDismissTicket"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="Dismiss"
                android:textColor="#8C7A70"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnContactReporter"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="Message"
                android:textColor="#BA5536"
                android:textSize="12sp"
                app:strokeColor="#BA5536" />

            <Button
                android:id="@+id/btnResolveTicket"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="#2DCE89"
                android:text="Resolve"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>