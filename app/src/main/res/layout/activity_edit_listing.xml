<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/appBackground">

    <LinearLayout
        android:id="@+id/editListingTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Circular Back Button -->
        <ImageButton
            android:id="@+id/btnBackEditListing"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="@string/desc_back_button"
            android:elevation="1dp"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/chevron_left"
            app:tint="#1F1614" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/editListingTopBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/edit_listing"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/property_name"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtEditPropertyName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/custom_input"
                android:paddingHorizontal="12dp"
                android:hint="@string/enter_property_name"
                android:inputType="textCapSentences"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/location"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtEditLocation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/custom_input"
                android:paddingHorizontal="12dp"
                android:hint="@string/enter_location"
                android:inputType="textCapSentences"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/monthly_price_r"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtEditPrice"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/custom_input"
                android:paddingHorizontal="12dp"
                android:hint="@string/enter_monthly_price"
                android:inputType="numberDecimal"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/number_of_rooms"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtEditRooms"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/custom_input"
                android:paddingHorizontal="12dp"
                android:hint="@string/enter_number_of_rooms"
                android:inputType="number"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/property_type"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtEditPropertyType"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/custom_input"
                android:paddingHorizontal="12dp"
                android:hint="@string/e_g_room_apartment_house"
                android:inputType="textCapSentences"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/description"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtEditDescription"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/custom_input"
                android:gravity="top|start"
                android:padding="12dp"
                android:hint="@string/describe_the_accommodation"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="4" />

            <Button
                android:id="@+id/btnSaveListingChanges"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/selector_regular_button"
                app:backgroundTint="@null"
                android:text="@string/save_changes"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textSize="15sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>