<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/appBackground">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/selector_regular_button"
            app:backgroundTint="@null"
            android:text="← Back"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textAllCaps="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtProfileTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/landlord_profile"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"/>

    <ScrollView
        android:id="@+id/profileScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/txtProfileTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp">

        <!-- Keep the rest of your original LinearLayout with all the profile buttons here -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtLandlordName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/landlord_name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/txtLandlordType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/landlord"
                android:textSize="16sp"
                android:padding="8dp"/>

            <Button
                android:id="@+id/btnPersonalInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_regular_button"
                app:backgroundTint="@null"
                android:text="@string/personal_information"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnChangeLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_regular_button"
                app:backgroundTint="@null"
                android:text="@string/change_language"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnMyListings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_regular_button"
                app:backgroundTint="@null"
                android:text="@string/my_listings"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnEnquiries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_regular_button"
                app:backgroundTint="@null"
                android:text="@string/listing_enquiries"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnPaymentsReceived"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_regular_button"
                app:backgroundTint="@null"
                android:text="@string/payments_received"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnPaymentHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_regular_button"
                app:backgroundTint="@null"
                android:text="@string/payment_history"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_regular_button"
                app:backgroundTint="@null"
                android:text="@string/notifications"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_regular_button"
                app:backgroundTint="@null"
                android:text="@string/change_password"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnReportProblem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_regular_button"
                app:backgroundTint="@null"
                android:text="@string/report_a_problem"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_regular_button"
                app:backgroundTint="@null"
                android:text="@string/log_out"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:layout_marginTop="16dp"/>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>