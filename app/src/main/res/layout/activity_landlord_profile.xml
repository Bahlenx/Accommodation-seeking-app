<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/back"
        android:textAllCaps="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:backgroundTint="#FFA500"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/txtProfileTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/landlord_profile"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"/>

    <ScrollView
        android:id="@+id/profileScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/txtProfileTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtLandlordName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/landlord_name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:padding="8dp"/>

            <TextView
                android:id="@+id/txtLandlordType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/landlord"
                android:textSize="16sp"
                android:padding="8dp"/>

            <Button
                android:id="@+id/btnPersonalInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFA500"
                android:text="@string/personal_information"
                android:textAllCaps="false"
                android:layout_marginTop="12dp"/>

            <Button
                android:id="@+id/btnMyListings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFA500"
                android:text="@string/my_listings"
                android:textAllCaps="false"/>

            <Button
                android:id="@+id/btnEnquiries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFA500"
                android:text="@string/listing_enquiries"
                android:textAllCaps="false"/>

            <Button
                android:id="@+id/btnPaymentsReceived"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFA500"
                android:text="@string/payments_received"
                android:textAllCaps="false"/>

            <Button
                android:id="@+id/btnPaymentHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFA500"
                android:text="@string/payment_history"
                android:textAllCaps="false"/>

            <Button
                android:id="@+id/btnNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFA500"
                android:text="@string/notifications"
                android:textAllCaps="false"/>

            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFA500"
                android:text="@string/change_password"
                android:textAllCaps="false"/>

            <Button
                android:id="@+id/btnReportProblem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFA500"
                android:text="@string/report_a_problem"
                android:textAllCaps="false"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFA500"
                android:text="@string/log_out"
                android:textAllCaps="false"
                android:layout_marginTop="16dp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>