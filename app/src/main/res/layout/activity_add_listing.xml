<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"
    android:fitsSystemWindows="true">

    <!-- Fixed top bar -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/back"
        android:textAllCaps="false"
        android:contentDescription="@string/desc_go_back"
        android:background="@drawable/selector_regular_button"
        app:backgroundTint="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtAddListingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:text="@string/add_new_listing"
        android:textColor="#222222"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    <!-- Scrollable form -->
    <ScrollView
        android:id="@+id/listingScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/edtPropertyName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/custom_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#0B0A0A"
                android:textColorHint="#4A4A4A"
                android:hint="@string/property_name"
                android:inputType="textCapSentences" />

            <EditText
                android:id="@+id/edtLocation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/custom_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#0B0A0A"
                android:textColorHint="#4A4A4A"
                android:hint="@string/location_hint"
                android:inputType="textCapSentences" />

            <!-- Accommodation type dropdown -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="@string/accommodation_type"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerAccommodationType"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/custom_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:entries="@array/accommodation_types"
                android:spinnerMode="dropdown"
                android:contentDescription="@string/accommodation_type" />

            <EditText
                android:id="@+id/edtPrice"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/custom_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#0B0A0A"
                android:textColorHint="#4A4A4A"
                android:hint="@string/price_per_month"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/edtRooms"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/custom_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#0B0A0A"
                android:textColorHint="#4A4A4A"
                android:hint="@string/number_of_rooms"
                android:inputType="number" />

            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/custom_input"
                android:padding="16dp"
                android:textColor="#0B0A0A"
                android:textColorHint="#4A4A4A"
                android:hint="@string/accommodation_description"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences" />

            <!-- Multi-image selection button -->
            <Button
                android:id="@+id/btnUploadImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/selector_regular_button"
                app:backgroundTint="@null"
                android:text="@string/upload_property_image"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/txtSelectedImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="4dp"
                android:text="No images selected"
                android:textColor="#4A4A4A"
                android:textSize="14sp" />

            <!-- Horizontal preview for selected photos -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="8dp"
                android:fillViewport="false"
                android:scrollbars="horizontal">

                <LinearLayout
                    android:id="@+id/imagePreviewContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

            </HorizontalScrollView>

            <!-- Kept for compatibility with the existing Java file.
                 Multi-image Java code should use imagePreviewContainer. -->
            <ImageView
                android:id="@+id/imgProperty"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                android:contentDescription="@string/property_image" />

            <Button
                android:id="@+id/btnSubmitListing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/selector_regular_button"
                app:backgroundTint="@null"
                android:text="@string/submit_listing"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>