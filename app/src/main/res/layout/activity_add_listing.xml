<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appBackground">

    <LinearLayout
        android:id="@+id/addListingHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBackAddListing"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="@string/desc_back_button"
            android:elevation="1dp"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/chevron_left"
            app:tint="#1F1614" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/add_accommodation"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/addListingScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/addListingHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/property_name"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtPropertyName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/custom_input"
                android:paddingHorizontal="12dp"
                android:hint="@string/enter_property_name"
                android:inputType="textCapSentences"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/property_location"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtLocation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/custom_input"
                android:paddingHorizontal="12dp"
                android:hint="@string/street_suburb_town_or_municipality"
                android:inputType="textCapSentences"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnVerifyLocation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/selector_regular_button"
                android:text="@string/verify_property_location"
                android:textColor="@color/white"
                android:textAllCaps="false"
                app:backgroundTint="@null" />

            <TextView
                android:id="@+id/tvLocationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:text="@string/location_has_not_been_verified_yet"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/monthly_rental_price_r"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtPrice"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/custom_input"
                android:paddingHorizontal="12dp"
                android:inputType="numberDecimal"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/number_of_rooms"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtRooms"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/custom_input"
                android:paddingHorizontal="12dp"
                android:hint="@string/number_of_available_rooms"
                android:inputType="number"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_type_of_accommodation"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp">

                <AutoCompleteTextView
                    android:id="@+id/dropdownPropertyType"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:inputType="none"
                    android:paddingHorizontal="12dp"
                    android:hint="@string/select_accommodation_type" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_the_water_source"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp">

                <AutoCompleteTextView
                    android:id="@+id/dropdownWaterSource"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:inputType="none"
                    android:paddingHorizontal="12dp"
                    android:hint="@string/select_water_source" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_the_electricity_supply"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp">

                <AutoCompleteTextView
                    android:id="@+id/dropdownElectricity"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:inputType="none"
                    android:paddingHorizontal="12dp"
                    android:hint="@string/select_electricity_supply" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_sanitation_and_toilet_facilities"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp">

                <AutoCompleteTextView
                    android:id="@+id/dropdownSanitation"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:inputType="none"
                    android:paddingHorizontal="12dp"
                    android:hint="@string/select_sanitation_type" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/property_description"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/custom_input"
                android:gravity="top|start"
                android:padding="12dp"
                android:hint="@string/describe_the_property_and_rental_conditions"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/additional_features_and_rules"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/select_features_such_as_wi_fi_parking_security_or_deposit_requirements"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSelectExtraAmenities"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/selector_regular_button"
                android:text="@string/select_features_and_rules"
                android:textColor="@color/white"
                android:textAllCaps="false"
                app:backgroundTint="@null" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgSelectedAmenities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/property_photos"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/you_can_select_more_than_one_photo_the_first_photo_will_be_the_main_listing_photo"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/imgProperty"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@drawable/custom_input"
                android:contentDescription="@string/preview_of_selected_property_photos"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery" />

            <TextView
                android:id="@+id/tvSelectedImageCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/no_photos_selected"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnUploadImage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/selector_regular_button"
                android:text="@string/choose_property_photos"
                android:textColor="@color/white"
                android:textAllCaps="false"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnSubmitListing"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/selector_regular_button"
                android:text="@string/publish_listing"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="@null" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
