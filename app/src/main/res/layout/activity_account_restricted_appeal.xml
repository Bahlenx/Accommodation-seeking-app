<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAF7F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account Restricted"
            android:textColor="#B91C1C"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FAF6F2"
            app:strokeColor="#D6CBC2"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCOUNT RESTRICTION"
                    android:textColor="#B91C1C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRestrictionType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1F1614"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Please review the administrator's notes below regarding your account status:"
                    android:textColor="#786F6B"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvAdminReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ikhaya_input_box"
                    android:padding="14dp"
                    android:textColor="#1F1614"
                    android:textSize="17sp"
                    android:lineSpacingExtra="5dp"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewAdminAttachment"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    app:cornerRadius="12dp"
                    android:text="View Admin Evidence"
                    android:textColor="#1F1614"
                    app:strokeColor="#D6CBC2"
                    app:backgroundTint="#FFFFFF"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FAF6F2"
            app:strokeColor="#D6CBC2"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APPEAL SUBMISSION"
                    android:textColor="#B91C1C"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Submit an Appeal"
                    android:textColor="#1F1614"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Explain why your account should be reinstated and attach evidence if available."
                    android:textColor="#786F6B"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etUserAppeal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Explain why you should be reinstated"
                    android:textColor="#1F1614"
                    android:textColorHint="#9E9E9E"
                    android:textSize="15sp"
                    android:inputType="textMultiLine"
                    android:lines="5"
                    android:gravity="top"
                    android:padding="14dp"
                    android:background="@drawable/bg_ikhaya_input_box"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAttachUserEvidence"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    app:cornerRadius="12dp"
                    android:text="Attach Evidence (Optional)"
                    android:textColor="#1F1614"
                    app:strokeColor="#D6CBC2"
                    app:backgroundTint="#FFFFFF"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvUserAttachmentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1F1614"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitAppeal"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    app:cornerRadius="12dp"
                    android:text="Submit Appeal"
                    app:backgroundTint="#B85032"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    app:cornerRadius="12dp"
                    android:text="Back to Login"
                    android:textColor="#1F1614"
                    app:strokeColor="#D6CBC2"
                    app:backgroundTint="#FFFFFF" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>