<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account Restricted"
            android:textColor="#D32F2F"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvRestrictionType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1F2937"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvAdminReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#4B5563"
                    android:textSize="17sp"
                    android:lineSpacingExtra="5dp"
                    android:layout_marginBottom="20dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewAdminAttachment"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    app:cornerRadius="12dp"
                    android:text="View Admin Evidence"
                    app:backgroundTint="#4B5563"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Submit an Appeal"
                    android:textColor="#1F2937"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/etUserAppeal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Explain why you should be reinstated"
                    android:textColor="#1F2937"
                    android:textColorHint="#4B5563"
                    android:inputType="textMultiLine"
                    android:lines="5"
                    android:gravity="top"
                    android:padding="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAttachUserEvidence"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    app:cornerRadius="12dp"
                    android:text="Attach Evidence (Optional)"
                    app:backgroundTint="#4B5563"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvUserAttachmentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1F2937"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitAppeal"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    app:cornerRadius="12dp"
                    android:text="Submit Appeal"
                    app:backgroundTint="#B85032" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:text="Back to Login"
            android:textColor="#1F2937"
            app:strokeColor="#1F2937"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>