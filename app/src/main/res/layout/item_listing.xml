<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="22dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgListing"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="#E9E3DE"
            android:contentDescription="@string/desc_property_image"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

        <TextView
            android:id="@+id/txtListingName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/placeholder_property_name"
            android:textColor="#241A18"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtListingLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/placeholder_location"
            android:textColor="#81736D"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtListingPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/placeholder_price"
            android:textColor="#B95737"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtListingRooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/label_rooms"
            android:textColor="#655A55"
            android:textSize="15sp" />

        <!-- Status Badge Chip -->
        <TextView
            android:id="@+id/tvLandlordStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFC107"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="PENDING APPROVAL"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Re-verification / Rejection Alert Banner (Hidden by default) -->
        <LinearLayout
            android:id="@+id/layoutReverificationAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFF3CD"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvReverificationReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Action Required: Address updated — please re-upload valid proof of authority."
                android:textColor="#856404"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEditListing"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#B95737"
                android:text="@string/btn_edit_item"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnMarkRented"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:backgroundTint="#6C757D"
                android:text="Mark Rented"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDeleteListing"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="#F0E4DF"
                android:text="@string/btn_delete"
                android:textAllCaps="false"
                android:textColor="#9E3828"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
