<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- TOP CHAT HEADER -->
    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Circular Back Button -->
        <ImageButton
            android:id="@+id/btnBackChat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="@string/desc_back_button"
            android:elevation="1dp"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/chevron_left"
            app:tint="#1F1614" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtChatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textColor="#212529"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtChatSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active"
                android:textColor="#4CAF50"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnClearChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete Chat"
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/btnChatOptions"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="⋮"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#212529"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- MESSAGES SCROLL AREA -->
    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/chatHeader"
        android:layout_above="@id/messageInputBar"
        android:fillViewport="true"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/messagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- BOTTOM MESSAGE INPUT BAR -->
    <LinearLayout
        android:id="@+id/messageInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnAttachFile"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="+"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/editMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:maxHeight="120dp"
            android:layout_weight="1"
            android:background="@drawable/custom_input"
            android:hint="Type a message..."
            android:inputType="textCapSentences|textMultiLine"
            android:scrollbars="vertical"
            android:scrollHorizontally="false"
            android:maxLength="3000"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="#212529"
            android:textColorHint="#6C757D" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/txtCharCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/1000"
                android:textSize="10sp"
                android:textColor="#6C757D"
                android:layout_marginBottom="2dp" />

            <Button
                android:id="@+id/btnSendMessage"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:background="@drawable/selector_regular_button"
                app:backgroundTint="@null"
                android:text="Send"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>