<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F5">

    <LinearLayout android:gravity="center_vertical" android:id="@+id/searchResultsHeader" android:layout_height="wrap_content" android:layout_width="0dp" android:orientation="horizontal" android:paddingBottom="16dp" android:paddingHorizontal="20dp" android:paddingTop="16dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">

        <Button android:background="@drawable/selector_regular_button" android:id="@+id/btnBack" android:layout_height="44dp" android:layout_width="wrap_content" android:text="@string/back" android:textAllCaps="false" android:textColor="#7A2525" app:backgroundTint="@null"/>

        <TextView android:id="@+id/txtSearchResultsTitle" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:layout_width="0dp" android:text="@string/search_results_title" android:textColor="#1F1614" android:textSize="22sp" android:textStyle="bold"/>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/searchResultsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/searchResultsHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="vertical" android:paddingBottom="32dp" android:paddingHorizontal="20dp">

            <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="27dp"
                    app:cardElevation="2dp">

                    <LinearLayout android:gravity="center_vertical" android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="horizontal" android:paddingHorizontal="16dp">

                        <ImageView android:contentDescription="Search" android:layout_height="18dp" android:layout_width="18dp" android:src="@drawable/search" app:tint="#8C7A70"/>

                        <EditText android:background="@null" android:hint="Search places or properties" android:id="@+id/searchBox" android:imeOptions="actionSearch" android:inputType="textCapWords" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_weight="1" android:layout_width="0dp" android:singleLine="true" android:textColor="#1F1614" android:textColorHint="#9E8F87" android:textSize="14sp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <FrameLayout android:background="@drawable/bg_circle_white" android:clickable="true" android:contentDescription="Show or hide filters" android:elevation="2dp" android:focusable="true" android:id="@+id/btnFilterToggle" android:layout_height="54dp" android:layout_width="54dp">

                    <ImageView android:layout_gravity="center" android:layout_height="20dp" android:layout_width="20dp" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="#1F1614"/>

                </FrameLayout>
            </LinearLayout>

            <Button android:background="@drawable/selector_regular_button" android:id="@+id/btnSearchAgain" android:layout_height="48dp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:text="@string/search_again" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" app:backgroundTint="@null"/>

            <LinearLayout android:background="@drawable/bg_circle_white" android:id="@+id/filtersPanel" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_width="match_parent" android:orientation="vertical" android:padding="16dp" android:visibility="gone">

                <TextView android:id="@+id/txtFiltersTitle" android:layout_height="wrap_content" android:layout_width="match_parent" android:text="@string/search_filters_title" android:textColor="#1F1614" android:textSize="18sp" android:textStyle="bold"/>

                <LinearLayout android:id="@+id/filterRow" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_width="match_parent" android:orientation="vertical">

                    <EditText android:background="@drawable/custom_input" android:hint="@string/search_max_price_hint" android:id="@+id/filterMaxPrice" android:inputType="numberDecimal" android:layout_height="50dp" android:layout_marginBottom="10dp" android:layout_width="match_parent" android:paddingHorizontal="12dp" android:textColor="#1F1614" android:textColorHint="#9E8F87"/>

                    <EditText android:background="@drawable/custom_input" android:hint="@string/search_min_rooms_hint" android:id="@+id/filterMinRooms" android:inputType="number" android:layout_height="50dp" android:layout_marginBottom="10dp" android:layout_width="match_parent" android:paddingHorizontal="12dp" android:textColor="#1F1614" android:textColorHint="#9E8F87"/>

                    <Spinner android:background="@drawable/custom_input" android:id="@+id/filterPropertyType" android:layout_height="50dp" android:layout_width="match_parent" android:paddingHorizontal="8dp"/>

                </LinearLayout>

                <Button android:background="@drawable/selector_regular_button" android:id="@+id/btnApplyFilters" android:layout_height="48dp" android:layout_marginTop="14dp" android:layout_width="match_parent" android:text="@string/search_apply_filters" android:textAllCaps="false" android:textColor="#FFFFFF" app:backgroundTint="@null"/>

            </LinearLayout>

            <TextView android:id="@+id/txtResultsCount" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:layout_width="match_parent" android:textColor="#756763" android:textSize="14sp"/>

            <ProgressBar android:id="@+id/progressSearch" android:layout_gravity="center_horizontal" android:layout_height="40dp" android:layout_marginTop="24dp" android:layout_width="40dp" android:visibility="gone" style="?android:attr/progressBarStyle"/>

            <TextView android:gravity="center" android:id="@+id/txtNoResults" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_width="match_parent" android:padding="20dp" android:text="@string/search_no_results" android:textColor="#756763" android:textSize="15sp" android:visibility="gone"/>

            <LinearLayout android:id="@+id/searchResultsContainer" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_width="match_parent" android:orientation="vertical"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>