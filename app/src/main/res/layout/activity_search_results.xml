<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F5"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">

        <!-- 1. TOP BAR: Close (Left), Centered Title, Filter (Right) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp">

            <!-- Circular Back Button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="@string/desc_back_button"
                android:elevation="1dp"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/chevron_left"
                app:tint="#1F1614" />

            <!-- Centered Header Title -->
            <TextView
                android:id="@+id/txtSearchResultsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/search_results_title"
                android:textColor="#1F1614"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Filter Options Button -->
            <ImageButton
                android:id="@+id/btnFilterOptions"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="@string/search_filters_title"
                android:elevation="1dp"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/funnel"
                app:tint="#1F1614" />
        </RelativeLayout>

        <!-- 2. SEARCH INPUT PILL -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="26dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/desc_search_icon"
                    android:src="@drawable/search"
                    app:tint="#8C7A70" />

                <EditText
                    android:id="@+id/searchBox"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="postalAddress"
                    android:background="@null"
                    android:hint="@string/hint_search_places"
                    android:imeOptions="actionSearch"
                    android:inputType="textCapWords"
                    android:singleLine="true"
                    android:textColor="#1F1614"
                    android:textColorHint="#9E8F87"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnSearchAgain"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_terracotta"
                    android:contentDescription="@string/search_again"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/search"
                    app:tint="#FFFFFF" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. HORIZONTAL QUICK CATEGORY PILLS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chipAllTypes"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#BA5536"
                    android:paddingHorizontal="16dp"
                    android:text="@string/filter_chip_all"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:cornerRadius="18dp" />

                <Button
                    android:id="@+id/chipRooms"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#FFFFFF"
                    android:paddingHorizontal="16dp"
                    android:text="@string/filter_chip_rooms"
                    android:textAllCaps="false"
                    android:textColor="#1F1614"
                    android:textSize="12sp"
                    app:cornerRadius="18dp" />

                <Button
                    android:id="@+id/chipShared"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#FFFFFF"
                    android:paddingHorizontal="16dp"
                    android:text="@string/filter_chip_shared"
                    android:textAllCaps="false"
                    android:textColor="#1F1614"
                    android:textSize="12sp"
                    app:cornerRadius="18dp" />

                <Button
                    android:id="@+id/chipHouses"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#FFFFFF"
                    android:paddingHorizontal="16dp"
                    android:text="@string/filter_chip_houses"
                    android:textAllCaps="false"
                    android:textColor="#1F1614"
                    android:textSize="12sp"
                    app:cornerRadius="18dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 4. RESULTS SCROLL CONTAINER -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/searchResultsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- DETAILED FILTERS CONTAINER (Preserved from Right Branch) -->
                <LinearLayout
                    android:id="@+id/layoutFilterSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/txtFiltersTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/search_filters_title"
                        android:textColor="#1F1614"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/filterRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/filterMaxPrice"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/custom_input"
                            android:hint="@string/search_max_price_hint"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="12dp"
                            android:textColor="#1F1614"
                            android:textColorHint="#9E8F87"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/filterMinRooms"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/custom_input"
                            android:hint="@string/search_min_rooms_hint"
                            android:inputType="number"
                            android:paddingHorizontal="12dp"
                            android:textColor="#1F1614"
                            android:textColorHint="#9E8F87"
                            android:textSize="14sp" />

                        <Spinner
                            android:id="@+id/filterPropertyType"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/custom_input"
                            android:paddingHorizontal="8dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnApplyFilters"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/selector_regular_button"
                        app:backgroundTint="@null"
                        android:text="@string/search_apply_filters"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Empty State Message -->
                <TextView
                    android:id="@+id/txtNoResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:text="@string/search_no_results"
                    android:textColor="#8C7A70"
                    android:textSize="15sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Container where listings are inserted -->
                <LinearLayout
                    android:id="@+id/searchResultsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>