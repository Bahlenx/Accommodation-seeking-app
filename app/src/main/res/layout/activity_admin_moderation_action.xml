<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Moderation Action"
            android:textSize="24sp"
            android:textColor="#1F2937"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Action Type"
                    android:textSize="18sp"
                    android:textColor="#1F2937"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <RadioGroup
                    android:id="@+id/rgActionType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <RadioButton
                        android:id="@+id/rbBan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#1F2937"
                        android:text="Permanent Ban"
                        android:checked="true"/>
                    <RadioButton
                        android:id="@+id/rbSuspend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#1F2937"
                        android:text="Timed Suspension"/>
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/llSuspensionDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_marginTop="16dp">
                    <EditText
                        android:id="@+id/etDuration"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="Duration"
                        android:textColor="#1F2937"
                        android:textColorHint="#4B5563"
                        android:padding="14dp"
                        android:background="@android:drawable/edit_text"
                        android:inputType="number" />
                    <Spinner
                        android:id="@+id/spinnerDurationType"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:entries="@array/duration_types" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reason for Moderation"
                    android:textSize="18sp"
                    android:textColor="#1F2937"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etAdminReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Provide detailed reason..."
                    android:textColor="#1F2937"
                    android:textColorHint="#4B5563"
                    android:inputType="textMultiLine"
                    android:lines="4"
                    android:gravity="top"
                    android:padding="14dp"
                    android:background="@android:drawable/edit_text"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAttachEvidence"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    app:cornerRadius="12dp"
                    android:text="Attach Evidence (Image/PDF)"
                    app:backgroundTint="#4B5563" />

                <TextView
                    android:id="@+id/tvAttachmentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#1F2937"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitAction"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            app:cornerRadius="12dp"
            android:text="Submit Moderation Action"
            app:backgroundTint="#D32F2F"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>