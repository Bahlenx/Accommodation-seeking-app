<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Row with Title and Close Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/btnCloseDialog"
                android:text="@string/apply_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <ImageButton
                android:id="@+id/btnCloseDialog"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Close"
                app:tint="@color/black" />
        </RelativeLayout>

        <TextView
            android:id="@+id/dialogPropertyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mthatha Listing • R950/month"
            android:textColor="@color/labelGray"
            android:textSize="14sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <!-- Full Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_full_name"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etApplicantName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/selector_regular_button"
            android:backgroundTint="#F2EEE9"
            android:paddingHorizontal="14dp"
            android:hint="e.g. John Doe"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:textSize="14sp"
            android:inputType="textPersonName" />

        <!-- ID / Passport Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_id_number"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etIdNumber"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/selector_regular_button"
            android:backgroundTint="#F2EEE9"
            android:paddingHorizontal="14dp"
            android:hint="13-digit RSA ID Number"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:textSize="14sp"
            android:inputType="number"
            android:maxLength="13" />

        <!-- Phone & Emergency Contact -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_contact_phone"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/selector_regular_button"
                    android:backgroundTint="#F2EEE9"
                    android:paddingHorizontal="14dp"
                    android:hint="072 000 0000"
                    android:textColor="@color/black"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:inputType="phone"
                    android:maxLength="10" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_emergency_contact"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEmergencyContact"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/selector_regular_button"
                    android:backgroundTint="#F2EEE9"
                    android:paddingHorizontal="14dp"
                    android:hint="082 111 2233"
                    android:textColor="@color/black"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:inputType="phone"
                    android:maxLength="10" />
            </LinearLayout>
        </LinearLayout>

        <!-- Occupation Dropdown & Move-in Date Picker -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_occupation_status"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerOccupation"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/selector_regular_button"
                    android:backgroundTint="#F2EEE9"
                    android:layout_marginTop="4dp"
                    android:entries="@array/occupations_array" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_move_in_date"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSelectedMoveInDate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/selector_regular_button"
                    android:backgroundTint="#F2EEE9"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:text="Select Date 📅"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Lease Duration & Occupants Dropdowns -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_lease_duration"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerLeaseDuration"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/selector_regular_button"
                    android:backgroundTint="#F2EEE9"
                    android:layout_marginTop="4dp"
                    android:entries="@array/lease_durations_array" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_occupants"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerOccupants"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/selector_regular_button"
                    android:backgroundTint="#F2EEE9"
                    android:layout_marginTop="4dp"
                    android:entries="@array/occupants_count_array" />
            </LinearLayout>
        </LinearLayout>

        <!-- Message/Note to Landlord -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_special_notes"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etTenantNote"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/selector_regular_button"
            android:backgroundTint="#F2EEE9"
            android:padding="12dp"
            android:gravity="top|start"
            android:hint="e.g. Quiet student, non-smoker"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:textSize="13sp" />

        <!-- Lease Agreement / Rules Acceptance Checkbox -->
        <CheckBox
            android:id="@+id/cbAcceptTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_agreement_checkbox"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:layout_marginBottom="18dp" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitApplication"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/selector_regular_button"
            app:backgroundTint="@color/colorSecondary"
            android:text="@string/btn_submit_application"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textSize="15sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>