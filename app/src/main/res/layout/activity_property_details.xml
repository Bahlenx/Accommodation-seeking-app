<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/propertyDetailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F5"
    android:fitsSystemWindows="false">

    <!-- MAIN SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailsScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- PROPERTY PHOTO / GALLERY -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="360dp">

                <ImageView
                    android:id="@+id/propertyImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#EAE5DF"
                    android:contentDescription="Property photo"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery" />

                <!-- PHOTO GALLERY CONTROLS -->
                <LinearLayout
                    android:id="@+id/propertyGalleryControls"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:background="#FFFFFF"
                    android:elevation="8dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btnPreviousPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:contentDescription="Previous photo"
                        android:gravity="center"
                        android:minWidth="70dp"
                        android:paddingHorizontal="8dp"
                        android:text="‹ Previous"
                        android:textColor="#1F1614"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPhotoCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:minWidth="48dp"
                        android:text="1 / 1"
                        android:textColor="#BA5536"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnNextPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:contentDescription="Next photo"
                        android:gravity="center"
                        android:minWidth="70dp"
                        android:paddingHorizontal="8dp"
                        android:text="Next ›"
                        android:textColor="#1F1614"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- TOP BACK AND SAVE BUTTONS -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingTop="48dp"
                    android:paddingEnd="20dp">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_circle_white"
                        android:contentDescription="Go back"
                        android:elevation="5dp"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/chevron_left"
                        app:tint="#1F1614" />

                    <ImageButton
                        android:id="@+id/btnSave"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_circle_white"
                        android:contentDescription="Save property"
                        android:elevation="5dp"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/heart"
                        app:tint="#BA5536" />

                </RelativeLayout>

            </FrameLayout>

            <!-- PROPERTY INFORMATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="22dp"
                android:paddingEnd="22dp"
                android:paddingBottom="145dp">

                <!-- PROPERTY NAME -->
                <TextView
                    android:id="@+id/propertyName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading property..."
                    android:textColor="#1F1614"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="Modern Student Accommodation" />

                <!-- VERIFIED BADGE -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_location_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="Verified"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="#007749" />

                    <TextView
                        android:id="@+id/tvVerifiedBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Verified Rental"
                        android:textColor="#007749"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- LOCATION -->
                <LinearLayout
                    android:id="@+id/layoutLocationAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Location"
                        android:src="@drawable/map_pin"
                        app:tint="#8C7A70" />

                    <TextView
                        android:id="@+id/propertyLocation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Loading location..."
                        android:textColor="#8C7A70"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnOpenMap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:text="View Map"
                        android:textColor="#BA5536"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- CONTACT LANDLORD -->
                <LinearLayout
                    android:id="@+id/btnContactLandlord"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Message landlord"
                        android:src="@drawable/messages_circle"
                        app:tint="#BA5536" />

                    <TextView
                        android:id="@+id/tvContactLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Contact Landlord"
                        android:textColor="#BA5536"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="22dp"
                    android:background="#E8E1DA" />

                <!-- AMENITIES -->
                <TextView
                    android:id="@+id/tvAmenitiesHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Amenities"
                    android:textColor="#1F1614"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupAmenities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="22dp"
                    android:background="#E8E1DA" />

                <!-- DESCRIPTION -->
                <TextView
                    android:id="@+id/descriptionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="About this Property"
                    android:textColor="#1F1614"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/propertyDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="5dp"
                    android:text="Loading description..."
                    android:textColor="#665B55"
                    android:textSize="14sp" />

                <!-- TRANSLATE -->
                <Button
                    android:id="@+id/btnTranslate"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="Translate"
                    android:textAllCaps="false"
                    android:textColor="#BA5536"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:cornerRadius="22dp" />

                <ProgressBar
                    android:id="@+id/progressTranslate"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <!-- MAP HEADING -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="12dp"
                    android:text="Property Location"
                    android:textColor="#1F1614"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- EMBEDDED MAP -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp">

                    <org.osmdroid.views.MapView
                        android:id="@+id/mapView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </androidx.cardview.widget.CardView>

                <!-- DIRECTIONS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGetDirections"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="Get Directions"
                    android:textAllCaps="false"
                    android:textColor="#1F1614"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp"
                    app:strokeColor="#E8E1DA"
                    app:strokeWidth="1dp" />

                <!-- OPTIONAL PROPERTY RULES -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupRules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp" />

                <!-- LANDLORD EDIT BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditListing"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="#BA5536"
                    android:text="Edit Listing"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="24dp" />

                <!-- COMPATIBILITY VIEW -->
                <Button
                    android:id="@+id/btnOpenFullMap"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- FIXED BOTTOM BOOKING BAR - ORIGINAL BACKGROUND RESTORED -->
    <LinearLayout
        android:id="@+id/floatingBookingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_floating_action_pill"
        android:elevation="20dp"
        android:gravity="center_vertical"
        android:minHeight="82dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="visible">

        <!-- LEFT SIDE: PRICE AND TERMS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/propertyPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="true"
                android:maxLines="2"
                android:text="Loading price..."
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="R 2,400 / mo" />

            <TextView
                android:id="@+id/tvTermsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="true"
                android:maxLines="2"
                android:text="Rental property"
                android:textColor="#FFE2D7"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- RIGHT SIDE: VIEWING BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyToRent"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="#FFFFFF"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="50dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Schedule Viewing"
            android:textAllCaps="false"
            android:textColor="#713D30"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="visible"
            app:cornerRadius="25dp"
            app:iconTint="#713D30" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
