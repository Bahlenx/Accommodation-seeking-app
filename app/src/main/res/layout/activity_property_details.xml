<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFA500"
            android:text="← Back"
            android:textAllCaps="false" />
        <TextView
            android:id="@+id/propertyImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:text="Property Photo"
            android:textSize="20sp"
            android:gravity="center"
            android:textColor="#666666"
            android:background="#E0E0E0"
            android:layout_marginTop="15dp" />
        <TextView
            android:id="@+id/propertyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Affordable Room"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/propertyPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R950 / month"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#C95A32"
            android:layout_marginTop="8dp" />
        <TextView
            android:id="@+id/propertyLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Mthatha, Eastern Cape"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Property Information"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="25dp" />

        <TextView
            android:id="@+id/propertyInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2 Rooms&#10;Water available&#10;Electricity available&#10;Parking available&#10;Available now"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginTop="10dp" />

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="25dp" />

        <TextView
            android:id="@+id/propertyDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Affordable accommodation located in a convenient area of Mthatha. Suitable for individuals looking for accessible and affordable housing."
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="♡ Save Listing"
            android:textAllCaps="false"
            android:layout_marginTop="30dp" />

        <Button
            android:id="@+id/btnContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contact Owner"
            android:textAllCaps="false"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</ScrollView>