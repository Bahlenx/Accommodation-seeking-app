<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F5">

    <!-- Fullscreen OpenStreetMap -->
    <org.osmdroid.views.MapView
        android:id="@+id/pickerMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Center Reticle Pin (Fixed in center, map moves beneath it) -->
    <ImageView
        android:id="@+id/imgCenterPin"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerInParent="true"
        android:translationY="-24dp"
        android:src="@drawable/map_pin"
        app:tint="#BA5536" />

    <!-- Top Search Container -->
    <LinearLayout
        android:id="@+id/topSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="36dp"
        android:orientation="vertical">

        <!-- Search Bar Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="26dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <EditText
                    android:id="@+id/etDialogSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search suburb, town, or mall..."
                    android:imeOptions="actionSearch"
                    android:inputType="textPostalAddress"
                    android:singleLine="true"
                    android:textColor="#1F1614"
                    android:textColorHint="#8C7A70"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/pbDialogSearch"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminateTint="#BA5536"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnDialogSearch"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Search"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#BA5536" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Dropdown Suggestions Container (Hidden until search returns multiple matches) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSearchSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/layoutSearchSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="6dp" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Floating "Locate Me" Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnDialogLocateMe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomLocationCard"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:backgroundTint="#FFFFFF"
        android:contentDescription="Locate Me"
        android:src="@android:drawable/ic_menu_mylocation"
        app:elevation="6dp"
        app:fabSize="mini"
        app:tint="#BA5536" />

    <!-- Bottom Confirmation Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomLocationCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Move map to align pin over property"
                android:textColor="#8C7A70"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSelectedAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:text="Locating address..."
                android:textColor="#1F1614"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnConfirmPin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#BA5536"
                android:text="Confirm Location"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
