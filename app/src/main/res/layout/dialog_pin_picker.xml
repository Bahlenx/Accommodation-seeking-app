<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F5">

    <!-- 1. The Interactive OSM Map -->
    <org.osmdroid.views.MapView
        android:id="@+id/pickerMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. The Static Center Crosshair Pin -->
    <!-- The translationY pulls it up slightly so the bottom "tip" of the icon points to the exact center -->
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerInParent="true"
        android:translationY="-24dp"
        android:contentDescription="@string/desc_map_pin"
        android:src="@android:drawable/ic_menu_mylocation"
        app:tint="#BA5536" />

    <!-- 3. Helper Text Floating at the Top -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/drag_map_pin_instruction"
            android:textColor="#1F1614"
            android:textSize="14sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <!-- 4. Floating My Location Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnDialogLocateMe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnConfirmPin"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/use_my_gps"
        android:src="@android:drawable/ic_menu_mylocation"
        app:backgroundTint="#FFFFFF"
        app:tint="#BA5536" />

    <!-- 5. The Save Button at the Bottom -->
    <Button
        android:id="@+id/btnConfirmPin"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:backgroundTint="#BA5536"
        android:text="@string/confirm_location_pin"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</RelativeLayout>