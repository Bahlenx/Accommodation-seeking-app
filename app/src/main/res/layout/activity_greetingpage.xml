<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appBackground"
    tools:context=".OuterMainActivity">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.22"
        android:scaleType="centerCrop"
        android:src="@drawable/ikhaya_background"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 1. Header Section -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="52dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/languageContainer"
        app:layout_constraintVertical_chainStyle="spread_inside">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:contentDescription="@string/app_name"
            app:srcCompat="@drawable/custom_ikhaya_background" />

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textColor="@color/black"
            android:textSize="36sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/app_slogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/slogan"
            android:textColor="@color/labelGray"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 2. Language Selection Section (Bounded to 300dp to preserve round pill proportions) -->
    <LinearLayout
        android:id="@+id/languageContainer"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomSection">

        <TextView
            android:id="@+id/language_selectionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/language_selection"
            android:textColor="@color/labelGray"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/English_btn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cornerRadius="25dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="@string/english_btn"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <Button
                android:id="@+id/afrikaans_btn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cornerRadius="25dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="@string/afrikaans_btn"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/sepedi_btn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cornerRadius="25dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="@string/sepedi_btn"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <Button
                android:id="@+id/isiXhosa_btn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cornerRadius="25dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="@string/isiXhosa_btn"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sesotho_btn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cornerRadius="25dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="@string/sesotho_btn"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <Button
                android:id="@+id/isiZulu_btn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cornerRadius="25dp"
                android:backgroundTint="@color/colorPrimary"
                android:text="@string/isiZulu_btn"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. Bottom CTAs (Bounded to 300dp and lifted clear of the nav bar) -->
    <LinearLayout
        android:id="@+id/bottomSection"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="54dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/languageContainer"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/get_started_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:cornerRadius="26dp"
            android:backgroundTint="@color/colorSecondary"
            android:text="@string/get_started_btn"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/existingUserText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/existing_user"
            android:textColor="@color/labelGray"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/existingUserBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:cornerRadius="26dp"
            android:backgroundTint="@color/colorSecondary"
            android:text="@string/existing_user_btn"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textAllCaps="false" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>