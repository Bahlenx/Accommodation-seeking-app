<!-- Outer FrameLayout handles status bar inset; inner LinearLayout keeps 20dp horizontal padding intact -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F5"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

    <!-- Top Navigation Bar matching activity_landlord_profile.xml -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnBackBansAppeals"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="@string/desc_back"
            android:elevation="1dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/chevron_left"
            app:tint="#1F1614" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_toEndOf="@id/btnBackBansAppeals"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADMIN MODERATION"
                android:textColor="#B91C1C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bans &amp; Appeals"
                android:textColor="#1F1614"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Search Bar Row (XML + Vector Drawables) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_ikhaya_input_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_vec_search"
            app:tint="#8C7A70" />

        <EditText
            android:id="@+id/etSearchBans"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search user, reason, or status..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#1F1614"
            android:textColorHint="#9E9E9E"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnClearBanSearch"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear search"
            android:padding="6dp"
            android:src="@drawable/ic_vec_close"
            android:visibility="gone"
            app:tint="#8C7A70" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSearchBans"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="Search"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#BA5536"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Filter & Sort Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterBans"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Filter: All"
            android:textAllCaps="false"
            android:textColor="#1F1614"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_vec_filter"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:iconTint="#BA5536"
            app:strokeColor="#D6CBC2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSortBans"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Sort: Newest"
            android:textAllCaps="false"
            android:textColor="#1F1614"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#FFFFFF"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_vec_sort"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:iconTint="#BA5536"
            app:strokeColor="#D6CBC2" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBanResultsCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="#8C7A70"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyBans"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="No moderation cases found."
        android:textColor="#8C7A70"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBansAppeals"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    </LinearLayout>
</FrameLayout>