<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="88dp"
            android:background="@drawable/selector_regular_button"
            app:backgroundTint="@null"
            android:text="@string/back"
            android:textAllCaps="false"
            android:textColor="#222222"
            android:elevation="0dp" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/change_language"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#171717" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Choose the language you want to use in the app."
            android:textSize="14sp"
            android:textColor="#777777"
            android:lineSpacingExtra="3dp" />

        <RadioGroup
            android:id="@+id/radioGroupLanguages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#F7F7F7">

            <RadioButton
                android:id="@+id/rbEnglish"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:buttonTint="#E69500"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/english"
                android:textColor="#292929"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbZulu"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:buttonTint="#E69500"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/isizulu"
                android:textColor="#292929"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbXhosa"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:buttonTint="#E69500"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/isixhosa"
                android:textColor="#292929"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbSesotho"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:buttonTint="#E69500"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/sesotho"
                android:textColor="#292929"
                android:textSize="16sp" />

        </RadioGroup>

        <Button
            android:id="@+id/btnApplyLanguage"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/selector_regular_button"
            app:backgroundTint="@null"
            android:text="Apply"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
