<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.IkhayaAccommodationSeekingApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Keep your existing colors here -->
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorSecondary</item>
        <item name="colorPrimaryVariant">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="colorSecondaryVariant">@color/colorPrimary</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Background Color -->
        <item name="android:colorBackground">@color/appBackground</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Force Light Mode -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Forces the top status bar icons (time, wifi, battery) to be dark -->
        <item name="android:windowLightStatusBar">true</item>

        <!-- Forces the placeholder text inside text boxes to be a visible gray -->
        <item name="android:textColorHint">#757575</item>

        <!-- Fix native EditText.setError() popup window text visibility -->
        <item name="android:textColorPrimaryInverse">#FFFFFF</item>
        <item name="android:textColorSecondaryInverse">#FFFFFF</item>
        <item name="android:colorForegroundInverse">#FFFFFF</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <!-- Customize your theme here. -->
    </style>
</resources>