<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- When the radio button is SELECTED -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" /> <!-- White box -->
            <corners android:radius="10dp" /> <!-- Slightly smaller radius to fit inside padding -->
        </shape>
    </item>

    <!-- When the radio button is UNSELECTED -->
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" /> <!-- Lets the beige show through -->
        </shape>
    </item>

</selector>