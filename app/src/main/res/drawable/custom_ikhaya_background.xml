<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <!-- Stack the white background, colorSecondary border, and the new foreground icon -->
        <layer-list>
            <!-- 1. White Background Shape with @color/colorSecondary Border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/white" />
                    <stroke
                        android:width="3dp"
                        android:color="@color/colorSecondary" />
                    <corners android:radius="28dp" />
                </shape>
            </item>

            <!-- 2. Your New Launcher Icon Foreground on Top (Negative values make it larger) -->
            <item
                android:drawable="@mipmap/ic_launcher_foreground"
                android:top="-12dp"
                android:bottom="-12dp"
                android:left="-12dp"
                android:right="-12dp" />
        </layer-list>
    </item>
</selector>