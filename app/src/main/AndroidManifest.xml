<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions for OpenStreetMap, Hardware GPS, and Supabase Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IkhayaAccommodationSeekingApp">

        <!-- Launcher Activity -->
        <activity
            android:name=".OuterMainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Navigation & User Flow -->
        <activity android:name=".HomeActivity" android:exported="false" />
        <activity android:name=".SearchResultsActivity" android:exported="false" />
        <activity android:name=".PropertyDetailsActivity" android:exported="false" />
        <activity android:name=".SavedListingsActivity" android:exported="false" />
        <activity
            android:name=".ViewingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".FilterBottomSheetDialog"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dashboards & Moderation Flow -->
        <activity android:name=".LandlordDashboardActivity" android:exported="false" />
        <activity android:name=".AdminDashboardActivity" android:exported="false" />
        <activity android:name=".AdminInspectionActivity" android:exported="false" />
        <activity android:name=".AdminUsersActivity" android:exported="false" />
        <activity android:name=".AdminPendingQueueActivity" android:exported="false" />
        <activity android:name=".AdminActiveListingsActivity" android:exported="false" />
        <activity android:name=".AdminReportsActivity" android:exported="false" />

        <!-- Listing Management & Landlord Actions -->
        <activity
            android:name=".AddListingActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
        <activity
            android:name=".EditListingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MyListingsActivity" android:exported="false" />
        <activity android:name=".ApplicationsActivity" android:exported="false" />
        <activity android:name=".EnquiriesActivity" android:exported="false" />
        <activity android:name=".LandlordViewingsActivity" android:exported="false" />

        <!-- Auth & Onboarding Flow -->
        <activity android:name=".RegistrationActivity" android:exported="false" />
        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".OtpActivity" android:exported="false" />
        <activity android:name=".CreatePasswordActivity" android:exported="false" />
        <activity android:name=".ChangePasswordActivity" android:exported="false" />
        <activity android:name=".PersonalActivity" android:exported="false" />

        <!-- Profiles & Settings -->
        <activity android:name=".TenantProfileActivity" android:exported="false" />
        <activity android:name=".LandlordProfileActivity" android:exported="false" />
        <activity android:name=".PersonalInformationActivity" android:exported="false" />
        <activity android:name=".LandlordPersonalInformationActivity" android:exported="false" />
        <activity android:name=".LanguageSettingsActivity" android:exported="false" />
        <activity android:name=".NotificationsActivity" android:exported="false" />
        <activity android:name=".PaymentHistoryActivity" android:exported="false" />
        <activity android:name=".PaymentsReceivedActivity" android:exported="false" />
        <activity android:name=".ReportProblemActivity" android:exported="false" />

        <!-- Messaging & Chat Flow -->
        <activity android:name=".UserSelectionActivity" android:exported="false" />
        <activity android:name=".ChatActivity" android:exported="false" />

    </application>

</manifest>